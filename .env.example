# Salin file ini menjadi .env.local lalu isi nilainya.
# Variabel yang diawali NEXT_PUBLIC_ bisa dibaca di browser (jangan isi rahasia).

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (lihat supabase/README.md)
# Ambil dari Supabase Dashboard > Project Settings > API Keys.
# SENGAJA tanpa NEXT_PUBLIC_ karena secret key tidak boleh sampai ke browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
